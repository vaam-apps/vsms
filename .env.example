# The console has no login and no credential of its own for a person: a browser
# pairs with a key it cannot export (docs/design/console-pairing.md). The server
# only carries sealed bytes to the gateway, and holds the composer's service key.

# SMS API upstream (dev default: local plain HTTP)
SMS_API_URL=http://127.0.0.1:8080

# mTLS certs to sms-api (omitted for http: dev default, required for https: production)
# SMS_API_CLIENT_CERT_PATH=/path/to/client.crt
# SMS_API_CLIENT_KEY_PATH=/path/to/client.key
# SMS_API_CA_PATH=/path/to/ca.crt

# The gateway's two PUBLIC sealing keys, as `sms-gateway server-keys` prints them
# (`current:` and `next:`). The browser pins them and believes no other answer.
SMS_ENVELOPE_SERVER_KEY_CURRENT=
SMS_ENVELOPE_SERVER_KEY_NEXT=

# The composer's own service key: an Ed25519 PKCS#8 PEM, registered with
# `sms-gateway register-client --client-name console-composer`
# (docs/runbooks/deployment.adoc, "The composer's key"). Optional: without it
# every screen works and the composer reports that it has no key.
# SMS_COMPOSER_KEY_FILE=/path/to/console-composer.pem

# Message stream polling interval (ms, min 500)
MESSAGE_STREAM_POLL_MS=2000

# Next.js env
NEXT_PUBLIC_APP_NAME=vsms Admin Console
NODE_ENV=development

# --- sms-gateway (the Rust API server, `backends/apps/sms-gateway serve`) ---
# Not consumed by the console above — listed here since this is the one
# .env.example in the repo. See backends/apps/sms-gateway/src/main.rs for the rest of
# that binary's flags (DATABASE_URL, the envelope keys, ORANGE_CM_*, ...).

# #134: the server-held pepper behind Message.msisdnHash/Message.bodyHash
# (backends/crates/sms-api/src/pepper.rs). Required — sms-gateway refuses to start
# without it. Real secret material: generate with `openssl rand -base64 48`,
# never commit a real value, at least 32 bytes (HashPepper::MIN_PEPPER_BYTES
# rejects anything shorter).
# SMS_HASH_PEPPER=
