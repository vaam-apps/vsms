# Dashboard auth — set to 'basic' with DASHBOARD_BASIC_USERS for HTTP Basic auth
DASHBOARD_AUTH=none
# DASHBOARD_BASIC_REALM=Admin Console
# DASHBOARD_BASIC_USERS=alice:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# SMS API upstream (dev default: local plain HTTP)
SMS_API_URL=http://127.0.0.1:8080

# mTLS certs to sms-api (omitted for http: dev default, required for https: production)
# SMS_API_CLIENT_CERT_PATH=/path/to/client.crt
# SMS_API_CLIENT_KEY_PATH=/path/to/client.key
# SMS_API_CA_PATH=/path/to/ca.crt

# OAuth2 client for console → sms-api (private_key_jwt)
SMS_AUTH_ISSUER=http://127.0.0.1:8080
SMS_CONSOLE_CLIENT_ID=sms-console
SMS_CONSOLE_PRIVATE_KEY_PATH=/path/to/private-key.pem
SMS_CONSOLE_SCOPE=sms:send sms:read job:read job:enqueue worker:read

# Message stream polling interval (ms, min 500)
MESSAGE_STREAM_POLL_MS=2000

# Next.js env
NEXT_PUBLIC_APP_NAME=vsms Admin Console
NODE_ENV=development

# --- sms-gateway (the Rust API server, `app/sms-gateway serve`) ---
# Not consumed by the console above — listed here since this is the one
# .env.example in the repo. See app/sms-gateway/src/main.rs for the rest of
# that binary's flags (DATABASE_URL, SMS_OIDC_ISSUER, ORANGE_CM_*, ...).

# #134: the server-held pepper behind Message.msisdnHash/Message.bodyHash
# (crates/sms-api/src/pepper.rs). Required — sms-gateway refuses to start
# without it. Real secret material: generate with `openssl rand -base64 48`,
# never commit a real value, at least 32 bytes (HashPepper::MIN_PEPPER_BYTES
# rejects anything shorter).
# SMS_HASH_PEPPER=
