# syntax=docker/dockerfile:1
#
# Build context is the repository root — the pnpm workspace root, needed
# for admin's own workspace dependencies (frontends/packages/env, ui, gateway, api,
# hooks). Build with `docker build -f frontends/apps/admin/Dockerfile .` from the repo
# root.

FROM node:26-bookworm-slim AS builder

# Matches package.json's own packageManager pin (pnpm@11.18.0) exactly,
# rather than whatever corepack's default would otherwise resolve to.
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

WORKDIR /repo
COPY . .

RUN pnpm install --frozen-lockfile

# `frontends/packages/sms-client` (generated by `cratestack generate-typescript` —
# see its own GENERATING.md) is deliberately NOT generated here. Nothing
# under frontends/apps/admin/ or frontends/packages/{api,gateway,hooks,ui,env}/src imports
# `@vsms/sms-client` yet — checked with a repo-wide grep before writing
# this Dockerfile, and confirmed empirically: `pnpm turbo run build
# --filter=admin...` succeeds without it. Generating it would mean
# compiling `cratestack-cli` from source (`cargo install cratestack-cli
# --version 0.7.8 --locked`, a full Rust build — see ci.yml's own `js` job)
# inside every admin image build, for zero runtime benefit today. The
# moment admin code actually imports it, this stage needs that install
# step ahead of `pnpm install` — not before, per this repo's own "no
# dormant machinery" convention.
#
# `next build` sets NODE_ENV=production, which would otherwise trip
# @vsms/env's deploy-time rules (DASHBOARD_AUTH, an https upstream) that
# only make sense at runtime, not compile time — same reasoning ci.yml's
# `js` job documents for its own SKIP_ENV_VALIDATION.
ENV SKIP_ENV_VALIDATION=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=admin...

# --- runtime -------------------------------------------------------------
FROM node:26-bookworm-slim AS runtime

RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin admin

WORKDIR /app

# Next's `output: "standalone"` (frontends/apps/admin/next.config.ts) traces the real
# runtime dependency graph — a minimal server.js plus only the
# node_modules it actually touches — verified against a real `next build`
# and `node server.js`, not assumed; see that config's own comment for the
# `outputFileTracingRoot` fix a monorepo checkout needed before tracing
# would even succeed. `.next/static` is not part of the standalone trace
# and needs its own copy. frontends/apps/admin/ has no `public/` directory today, so
# there is nothing to copy for it.
COPY --from=builder --chown=admin:admin /repo/frontends/apps/admin/.next/standalone/ ./
COPY --from=builder --chown=admin:admin /repo/frontends/apps/admin/.next/static ./frontends/apps/admin/.next/static

USER admin

# Not 3000 (Next's own default) — this deployment's own convention:
# nothing behind the §9.2 Caddy edge needs a "standard" port, and every
# other service here (sms-gateway, sms-worker's health file) already picks
# its own.
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
EXPOSE 8080

# frontends/apps/admin/app/api/health already existed before this PR — the one health
# endpoint this repo had prior to #139. No curl in this slim image; Node
# itself makes the request rather than adding a package just for this.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:8080/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["node", "frontends/apps/admin/server.js"]
