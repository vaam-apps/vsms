# syntax=docker/dockerfile:1
#
# Build context is the repository root — the pnpm workspace root, needed
# for admin's own workspace dependencies (frontends/packages/env, gateway, api,
# hooks). Build with `docker build -f frontends/apps/admin/Dockerfile .` from the repo
# root.

# The toolchain the console's build needs and Node's image lacks: Rust with the
# wasm32 target, for the browser's sealing module (`sdks/rust/vsms-sdk-wasm`,
# built with `--target web` into `public/sealer/`) and for the Node SDK the
# composer's route signs with. Copied from the same `rust:1.98-bookworm` the CI
# runner image is (`ci/runner/Dockerfile`; 1.98 is the workspace's
# `rust-version`), so the compiler is not a version this repository pins twice.
FROM rust:1.98-bookworm AS rust

FROM node:26-bookworm-slim AS builder

# A linker and libc headers for the build scripts and proc macros that run on
# the build machine itself; the wasm32 target needs neither.
# DL3008: no apt version pin, deliberately — the packages come from the
# floating Debian bookworm suite the base image tracks, and a patch pin would
# fail the build the day the mirror drops that exact revision (the same call
# as ci/runner/Dockerfile's).
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN rustup target add wasm32-unknown-unknown

# Node 26 no longer bundles corepack — it was removed from the Node
# distribution (verified: `node:26-bookworm-slim` has npm but no corepack;
# `actions/setup-node`'s Node 26 still ships it, which is why only this
# Docker build hit the gap). Install it explicitly, pinned, then use it to
# honour package.json's own packageManager pin (pnpm@11.18.0) exactly,
# rather than whatever corepack's default would otherwise resolve to.
RUN npm install -g corepack@0.35.0 && corepack enable && corepack prepare pnpm@11.18.0 --activate

WORKDIR /repo
COPY . .

RUN pnpm install --frozen-lockfile

# `wasm-bindgen`'s command-line tool at exactly the version `sdks/rust/Cargo.lock`
# pins for the crate: the tool and the crate agree on a private interface, and a
# mismatch fails at load time in the browser naming neither (`just wasm-tools`
# is the same install, for a machine that has `just`).
RUN wanted="$(awk '/^name = "wasm-bindgen"$/ {getline; gsub(/version = |"/, ""); print; exit}' sdks/rust/Cargo.lock)" \
    && cargo install wasm-bindgen-cli --locked --version "$wanted"

# `pnpm turbo run build --filter=admin...` below makes two WebAssembly modules from
# `sdks/rust/vsms-sdk-wasm`: the browser's (`public/sealer/`, served by the
# console's own origin and loaded at run time, never bundled) and the Node SDK's
# (embedded in its JavaScript as bytes, so the standalone trace needs no `.wasm`
# file beside it).
#
# `frontends/packages/sms-client` (generated by `cratestack generate-typescript` —
# see its own GENERATING.md) is deliberately NOT generated here. Nothing
# under frontends/apps/admin/ or frontends/packages/{api,gateway,hooks,env}/src imports
# `@vsms/sms-client` yet — checked with a repo-wide grep before writing
# this Dockerfile, and confirmed empirically: `pnpm turbo run build
# --filter=admin...` succeeds without it. Generating it would mean
# compiling `cratestack-cli` from source (`cargo install cratestack-cli
# --version "$(cargo xtask cratestack-pin)" --locked`, a full Rust build —
# see ci.yml's own `js` job)
# inside every admin image build, for zero runtime benefit today. The
# moment admin code actually imports it, this stage needs that install
# step ahead of `pnpm install` — not before, per this repo's own "no
# dormant machinery" convention.
#
# `next build` sets NODE_ENV=production, which would otherwise trip
# @vsms/env's deploy-time rules (DASHBOARD_AUTH, an https upstream) that
# only make sense at runtime, not compile time — same reasoning ci.yml's
# `js` job documents for its own SKIP_ENV_VALIDATION.
ENV SKIP_ENV_VALIDATION=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=admin...

# --- runtime -------------------------------------------------------------
FROM node:26-bookworm-slim AS runtime

RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin admin

WORKDIR /app

# Next's `output: "standalone"` (frontends/apps/admin/next.config.ts) traces the real
# runtime dependency graph — a minimal server.js plus only the
# node_modules it actually touches — verified against a real `next build`
# and `node server.js`, not assumed; see that config's own comment for the
# `outputFileTracingRoot` fix a monorepo checkout needed before tracing
# would even succeed. `.next/static` is not part of the standalone trace
# and needs its own copy, as does `public/` below.
COPY --from=builder --chown=admin:admin /repo/frontends/apps/admin/.next/standalone/ ./
COPY --from=builder --chown=admin:admin /repo/frontends/apps/admin/.next/static ./frontends/apps/admin/.next/static
# The browser's sealing module (`public/sealer/`): not part of the standalone
# trace, and without it the console cannot sign a single request.
COPY --from=builder --chown=admin:admin /repo/frontends/apps/admin/public ./frontends/apps/admin/public

# Numeric uid, not `USER admin`: a kubelet cannot verify that a named
# user is non-root, so `runAsNonRoot: true` without a `runAsUser` refuses the
# pod with "image has non-numeric user (admin), cannot verify user is
# non-root". 10001 is the uid created above (and the one
# docs/runbooks/deployment.adoc chowns the console key to).
# `ci/assert-image.sh` fails the image build if this becomes a name again.
USER 10001

# Not 3000 (Next's own default) — this deployment's own convention:
# nothing behind the §9.2 Caddy edge needs a "standard" port, and every
# other service here (sms-gateway, sms-worker's health file) already picks
# its own.
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
EXPOSE 8080

# frontends/apps/admin/app/api/health already existed before this PR — the one health
# endpoint this repo had prior to #139. No curl in this slim image; Node
# itself makes the request rather than adding a package just for this.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:8080/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["node", "frontends/apps/admin/server.js"]
