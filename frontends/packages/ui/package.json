{
  "name": "@vaam-apps/ui",
  "version": "0.1.0",
  "description": "A dark-first React component library for operator consoles \u2014 daisyUI styling, Headless UI behaviour, and a parameterised status-glyph system.",
  "license": "MIT",
  "author": "Vaam Apps",
  "homepage": "https://github.com/vaam-apps/vsms/tree/main/frontends/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/vsms.git",
    "directory": "frontends/packages/ui"
  },
  "bugs": {
    "url": "https://github.com/vaam-apps/vsms/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "daisyui",
    "headlessui",
    "dashboard",
    "admin"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/theme.css": "./src/styles/theme.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/specify-extensions.mjs dist",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "daisyui": "^5",
    "react": "^18.3.0 || ^19",
    "react-dom": "^18.3.0 || ^19",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dialog": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.44.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
