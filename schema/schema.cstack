// SMS Gateway - CrateStack schema
// Validated against cratestack 0.4.16: parses, emits Postgres DDL, and expands
// through include_server_schema! (no scalar list fields - see architecture.md 2.0)

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum MessageClass {
  otp
  transactional
  notification
  marketing
}

enum MessageState {
  accepted
  queued
  routed
  submitted
  delivered
  uncertain
  undelivered
  failed
  expired
  rejected
  cancelled
}

enum JobState {
  pending
  running
  succeeded
  failed
  dead
  cancelled
}

enum Encoding {
  gsm7
  ucs2
}

enum OperatorCode {
  mtn
  orange
  camtel
  nexttel
  unknown
}

enum OperatorPrefixSource {
  seed
  manual
  dlr_observed
}

enum OperatorPrefixConfidence {
  verified
  likely
  contested
  unverified
}

enum ProviderKind {
  orange_cm_http
  mtn_http
  aggregator_http
  smpp
}

enum ProviderState {
  active
  degraded
  disabled
  draining
}

enum DeliveryOutcome {
  delivered
  uncertain
  failed
  expired
  rejected
  unknown
}

enum AttemptState {
  pending
  delivering
  succeeded
  failed
  dead
}

enum OptOutSource {
  inbound_stop
  admin
  import
  operator
}

// #72: how a `ConsentRecord` was captured. Deliberately an enum, not a
// free-form String the way `OptOut.scope` is — `ConsentRecord.scope`
// reuses `MessageClass` itself (see that model's own comment) rather than
// inventing a second string vocabulary that could drift from it, and this
// enum is the equivalent discipline for "channel". `admin`/`import` mirror
// `OptOutSource`'s own two non-runtime-observed sources; the rest are
// capture channels a signup flow plausibly uses.
enum ConsentChannel {
  web_form
  api
  ivr
  paper_form
  verbal
  sms_keyword
  import
  admin
}

// The client-authentication method a registration is bound to at /token
// (OIDC Core 9). There is deliberately no client_secret_basic and no
// client_secret_post: machine callers authenticate with private_key_jwt and
// the admin console is a public client protected by PKCE, so no shared
// secret exists anywhere in this system to leak, hash, or rotate.
//
// authkestra maps a *missing* token_endpoint_auth_method to "registration
// predates the field", which accepts a secret from either transport and
// refuses assertions outright. Making this column NOT NULL with no default
// means every row names its method and that branch is unreachable.
enum ClientAuthMethod {
  private_key_jwt
  none
}

mixin Timestamps {
  createdAt DateTime @default(dbgenerated())
  updatedAt DateTime @default(dbgenerated())
}

auth Principal {
  sub String
  kind String
  role String
  appId Cuid
}

model App {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  slug String @unique @regex("^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$")
  description String?
  defaultSenderIdId Cuid?
  defaultSender SenderId? @relation(fields: [defaultSenderIdId], references: [id])
  monthlyQuota Int
  ipAllowlist String
  transliterateToGsm7 Boolean
  active Boolean @default(true)
  deletedAt DateTime?
  // #59: an operator-editable model, so two consoles racing a PATCH need
  // If-Match to produce a 412 rather than a silent last-write-wins. See
  // that ticket's own PR for the full "which models get @version" survey.
  version Int @version

  clients AppClient[] @relation(fields: [id], references: [appId])
  messages Message[] @relation(fields: [id], references: [appId])

  @@soft_delete
  @@audit
  @@paged
  // hasRole('system') added here alongside the human-facing roles — found
  // live, the same way as AppClient's missing create policy just above:
  // §3.2's own sequence diagram has the *gateway itself* doing
  // "client_id -> AppClient -> App (cached 60s)" as an internal step on
  // every authenticated request, which is a system operation, not a human
  // admin-console one. Without this, sendMessage's own App lookup — under
  // the system context every other cross-cutting read in that procedure
  // already uses — returns nothing, so a caller sees "unknown client" on
  // every request from a client that unquestionably exists.
  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('developer') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin'))
  @@allow("update", hasRole('owner') || hasRole('admin'))
  @@allow("delete", hasRole('owner'))
  @@emit(created, updated, deleted)
}

model AppClient {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  appId Cuid
  app App @relation(fields: [appId], references: [id])
  clientId String @unique @length(min: 8, max: 64)
  label String @length(min: 1, max: 64)
  scopes String
  active Boolean @default(true)
  lastUsedAt DateTime?
  retiredAt DateTime?
  // #59: operator-editable (owner/admin retire or relabel a client).
  version Int @version

  @@audit
  @@paged
  // hasRole('system') added alongside the human roles — same root cause as
  // App's own read policy just above: sendMessage's clientId -> AppClient
  // lookup runs under a system context, and without this the row it just
  // created under that same context is invisible to it a moment later.
  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('developer') || hasRole('system'))
  // No @@allow("create", ...) at all here previously — deny-by-default
  // (§2.0) meant nobody, not even system, could ever write an AppClient
  // row through the generated API. Found live: seeding one for #32's own
  // test suite raised Forbidden("create policy denied this operation")
  // under every role tried, owner included. hasRole('system') matches the
  // convention every other model with a procedure-only write path already
  // uses (OauthClient, ClientAssertion) — provisionAppClient (#23) is
  // this model's intended sole writer, the same way SmsClientStore is
  // OauthClient's.
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('owner') || hasRole('admin'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, updated, deleted)
}

model OauthClient {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  clientId String @unique @length(min: 8, max: 64)
  appClientId Cuid?
  appClient AppClient? @relation(fields: [appClientId], references: [id])
  tokenEndpointAuthMethod ClientAuthMethod
  jwks String?
  grantTypes String
  scopes String
  redirectUris String
  requirePkce Boolean
  active Boolean @default(true)

  @@audit
  @@allow("read", hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
}

// The OP's RS256 signing keys. `id` doubles as the JWKS `kid`, which is why it
// has to be a plain Cuid rather than anything structured.
//
// @sensitive redacts audit snapshots ONLY - it adds no serde attribute, so
// this model's `hasRole('system')` read policy is the entire confidentiality
// control over the private key. `system` is a synthetic internal role that no
// token may ever carry; an AuthProvider that mints it for HTTP callers hands
// them the key that signs every token. See 4.2.
model OauthSigningKey {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  privateKeyPem String @sensitive
  active Boolean @default(true)
  expiresAt DateTime?

  @@audit
  @@allow("read", hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
}

// Spent private_key_jwt client-assertion `jti`s (RFC 7523 2.2), so a captured
// assertion is single-use rather than a bearer credential good for its whole
// lifetime.
//
// Insert-only, and that is the design: authkestra requires record_jti to be
// atomic, and `create` + catching SQLSTATE 23505 on the @unique index is
// exactly that. A read-then-write across two statements would be the TOCTOU
// race this table exists to prevent - two concurrent replays would both
// observe "not yet seen". Same reason upsert is unavailable here anyway
// (2.0: no upsert when the @id has a default).
//
// No @@audit: one row per token request, and the audit row would carry no
// information the row itself doesn't. Rows are reaped once expiresAt passes,
// after which the assertion is refused on `exp` regardless.
model ClientAssertion {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  jti String @unique @length(min: 1, max: 255)
  expiresAt DateTime

  @@allow("read", hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("delete", hasRole('system'))
}

model SenderId {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  value String @unique @length(min: 3, max: 11) @db_enforce
  kind String
  notes String?
  active Boolean @default(false)
  // #59: operator-editable (activation, notes).
  version Int @version

  registrations SenderIdRegistration[] @relation(fields: [id], references: [senderIdId])

  @@audit
  @@allow("read", auth().kind == "user" || auth().kind == "app")
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @@emit(created, updated)
}

model SenderIdRegistration {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  senderIdId Cuid
  senderId SenderId @relation(fields: [senderIdId], references: [id])
  providerId Cuid
  provider Provider @relation(fields: [providerId], references: [id])
  status String
  submittedAt DateTime?
  approvedAt DateTime?
  reference String?
  rejectionReason String?
  // #59: operator-editable (approve/reject a registration).
  version Int @version

  // read: found live debugging #32's sendMessage — resolve_sender_id()'s
  // approval lookup runs under Procedures::sys() (kind=App, role=system),
  // which satisfied neither clause here, so a correctly-seeded approved
  // registration was invisible to the procedure that needs to see it. Same
  // root cause, same fix, as App and AppClient's own read policies above.
  @@audit
  @@allow("read", auth().kind == "user" || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('operator'))
}

model Provider {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  key String @unique @regex("^[a-z][a-z0-9_]{2,31}$")
  displayName String @length(min: 2, max: 64)
  kind ProviderKind
  state ProviderState @default('disabled')
  config String
  credentialRef String
  maxTps Float
  maxDailySubmissions Int
  supportsDlr Boolean
  supportsAlphaSender Boolean
  supportsUcs2 Boolean
  supportsConcat Boolean
  costPerSegmentXaf Decimal
  healthCheckedAt DateTime?
  healthy Boolean @default(false)
  // #63: the provider-side circuit breaker §6.3 specifies ("five
  // consecutive Unavailable opens it for 60s") — same two-column shape as
  // WebhookEndpoint's own breaker (#41/#59), deliberately: a second breaker
  // with different field names or semantics in the same codebase is worse
  // than a slightly imperfect consistent one. `crates/sms-worker/src/
  // dispatch.rs` is the one writer (`record_provider_failure`/
  // `reset_provider_failures`, mirroring `hooks.rs`'s own); `crates/
  // sms-worker/src/routing.rs::convert_provider` is the one reader —
  // `available` is `false` while `circuitOpenUntil` is in the future,
  // exactly like `claim.rs::filter_by_endpoint_health` already treats
  // WebhookEndpoint's own open circuit as unclaimable.
  consecutiveFailures Int @default(0)
  circuitOpenUntil DateTime?
  // #59: the ticket's own motivating case — two operators editing the
  // same provider config must not silently last-write-wins.
  version Int @version

  routes Route[] @relation(fields: [id], references: [providerId])

  // read: found live building #33's dispatch role — its routing pass
  // (cheapest_active_provider, crates/sms-worker/src/claim.rs) runs under
  // a system context, same root cause as App/AppClient/SenderIdRegistration/
  // OperatorPrefixRule's own read policies (see their comments for how
  // this pattern keeps recurring: any model an internal procedure or
  // worker role reads needs hasRole('system') alongside the human roles).
  //
  // update: #63, the eleventh instance of this exact gap shape but the
  // first on an `update` action rather than `list`/`detail` — found live,
  // not by review, the same way every prior instance was. `dispatch.rs`'s
  // `record_provider_failure`/`reset_provider_failures` (the circuit
  // breaker this PR adds) write this model under `sys()`, and without
  // `hasRole('system')` here every one of those writes returned
  // `Forbidden("update policy denied this operation")` — not a compile
  // error, not even a loud runtime one from this crate's own perspective
  // (`hooks::record_endpoint_failure`'s "log and drop" best-effort
  // handling absorbed it exactly like it absorbs a lost CAS race), so the
  // circuit breaker silently never opened. `an_open_circuit_routes_new_
  // messages_to_the_alternative_instead_of_rejecting`
  // (`crates/sms-worker/tests/dispatch_live_postgres.rs`) is what caught
  // it: `provider.version` never advanced past the one bump
  // `seed_two_routed_providers`'s own `owner()`-context activation made,
  // proving every `sys()`-context write after it was rejected.
  // #54: `auth().kind == "app"` added alongside the human roles — the same
  // shape #56/#57 gave `Job`'s own `@@allow("list"/"detail", ...)`, for the
  // identical reason: the admin console's Providers screen authenticates
  // with the console's own machine credential (`role: "app"`, no human
  // role — #97/#98's scope cut, still unclosed at time of writing), and
  // `Provider` has no `appId` to scope a row-level predicate by, the same
  // "unscoped but Layer 2-gated" shape `SenderId`/`OptOut` already use.
  // `router::PROVIDER_ROUTE_READ_ROUTES` gates `GET /providers`/
  // `GET /providers/{id}` on `provider:read` (§5.2) at Layer 2, matching
  // `JOB_READ_ROUTES`'s own precedent — that is the *real* perimeter for
  // this screen today, not defense in depth, same reasoning as `Job`'s own
  // comment. `PATCH /providers/{id}` is untouched: no `auth().kind ==
  // "app"` on the `update` policy below, so writing still needs a human
  // role no token this deployment can currently mint carries.
  @@audit
  @@allow("read", auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin'))
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))
  @@allow("delete", hasRole('owner'))
  @@emit(created, updated, deleted)
}

model Route {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  priority Int @range(min: 0, max: 1000)
  weight Int @range(min: 0, max: 1000)
  enabled Boolean
  matchOperator OperatorCode?
  matchClass MessageClass?
  matchAppId Cuid?
  matchPrefix String?
  providerId Cuid
  provider Provider @relation(fields: [providerId], references: [id])
  failoverRouteId Cuid?
  // #59: this is the ticket's own worked example — "two operators editing
  // the same route" needed this field to exist before it could be true.
  version Int @version

  // read: the tenth instance of AGENTS.md's own nine-times-repeated
  // hasRole('system') gap (#62) — real Route-rule routing (§6.3) now
  // exists (crates/sms-worker/src/routing.rs, driven from
  // crates/sms-worker/src/claim.rs's `accepted` branch), and its query
  // runs under a system context the same way `cheapest_active_provider`'s
  // did before it. Caught in advance here, before merge, by #155's own
  // golden test (crates/sms-api/tests/system_context_golden_list_live_postgres.rs)
  // rather than found live afterward — see that file for the guard and
  // AGENTS.md for this instance's own record.
  //
  // #54: `auth().kind == "app"` added alongside the human roles, same
  // reasoning and same precedent as `Provider.read`'s own comment just
  // above — the admin console's Routes screen (list) and the
  // `simulateRoute` procedure both need a real machine credential to read
  // this model, and `Route` has no `appId` either. `router::
  // PROVIDER_ROUTE_READ_ROUTES` gates `GET /routes`/`GET /routes/{id}` on
  // `route:read`; `simulateRoute` itself gates on the same permission via
  // `require_permission` inside the procedure body (it reads under a
  // `sys()` context internally, so this `@@allow` change isn't what makes
  // the procedure work — `hasRole('system')` already covered that — but it
  // is what makes the plain `GET /routes` list screen work). Write actions
  // below are untouched: still owner/admin-only, so `POST`/`PATCH`/`DELETE
  // /routes` remain unreachable by this console's own credential, same gap
  // #59's `rest.ts` module doc already documents for `Provider`.
  @@audit
  @@allow("read", auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin'))
  @@allow("update", hasRole('owner') || hasRole('admin'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, updated, deleted)
}

// Feeds sms_msisdn::OperatorPrefixTable, which ships with zero built-in rows
// on purpose (see §3.4) — prefix routing must never be load-bearing, so the
// table lives here where operations can correct it without a deploy. Seeded
// from best current evidence in 0002_bootstrap; corrected over time either by
// an admin (source=manual) or automatically from DeliveryReceipt.networkCode
// (source=dlr_observed, which is what lastObservedAt tracks).
//
// Named *Rule, not *Prefix: pluralize() is naive (ends_with('s') ? +"es" :
// +"s") and does not know that "prefix" ends in x, so "OperatorPrefix" would
// table as operator_prefixs. Same trap that made WebhookAttempt not
// WebhookDelivery.
model OperatorPrefixRule {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  // @db_enforce backs @length with a real CHECK but is a silent no-op on
  // @regex — verified by probe, see §2.0. So the format guarantee for this
  // column is hand-written in 0002_bootstrap instead, not the attribute
  // below; @regex here is app-layer validation only.
  prefix String @unique @regex("^[0-9]{1,4}$")
  operator OperatorCode
  source OperatorPrefixSource @default('seed')
  confidence OperatorPrefixConfidence @default('unverified')
  lastObservedAt DateTime?
  notes String?
  active Boolean @default(true)
  // #59: operator-editable (correcting a prefix's operator/confidence).
  version Int @version

  // read: found live debugging #32's sendMessage — classify_operator()'s
  // table-rebuild query runs under Procedures::sys() (kind=App,
  // role=system), which satisfied none of the human-role clauses below, so
  // every send silently classified as `unknown` instead of querying the
  // seeded rows. Same root cause, same fix, as SenderIdRegistration's own
  // read policy above.
  @@audit
  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin'))
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('system'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, updated, deleted)
}

model Message {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  appId Cuid
  app App @relation(fields: [appId], references: [id])

  clientRef String?
  idempotencyKey String?

  msisdn String @pii @length(min: 12, max: 15)
  msisdnHash String
  operator OperatorCode

  senderIdValue String @length(min: 3, max: 11)
  class MessageClass
  priority Int @range(min: 0, max: 1000)

  body String? @sensitive
  bodyHash String
  bodyLength Int
  encoding Encoding
  segments Int @range(min: 1, max: 10)

  state MessageState @default('accepted')
  stateReason String?
  routeId Cuid?
  providerId Cuid?
  providerMessageRef String?
  providerMessageRefAlt String?
  // #63: the failed `Route.id`s this message has already been rerouted
  // away from, sentinel-packed (`sms_core::pack`/`unpack` — see that
  // crate's own module doc; `Route.id` is a `Cuid`, format-guarded
  // `[a-z0-9]{2,32}`, so it can never contain the separator or be empty,
  // the two cases `pack` rejects). Both the exclude set `crates/sms-worker/
  // src/dispatch.rs::attempt_failover` re-runs `sms_routing::select_route`
  // with, and the two-hop cap §6.3 specifies — `unpack(...).len()` past 2
  // means the next failure is terminal-for-this-message, not another
  // reroute. `None`/absent until the first failover hop; never touched by
  // `sendMessage` or by any state transition that isn't a failover reroute.
  excludedRouteIds String?

  attempts Int @default(0)
  maxAttempts Int
  leaseOwner String?
  leaseUntil DateTime?
  scheduledAt DateTime?
  expiresAt DateTime
  submittedAt DateTime?
  finalizedAt DateTime?

  // #67/#5: 90-day minimisation, decided — no split ledger. `purge_retention`
  // (crates/sms-worker/src/jobs/purge_retention.rs) stamps this the one time
  // it nulls `body`/`clientRef`/`idempotencyKey`/`stateReason` and overwrites
  // `msisdn`, so "purged" is data, not an inference from "body happens to be
  // null" — nothing else in this codebase ever nulls `body` (the #183
  // redact-at-terminal-state idea was built and rejected; see docs/architecture.md
  // §2.5), but a dedicated marker is unambiguous where an inferred one would
  // silently break the day something else does. No `@default`: absent on
  // every row until the job actually reaches it.
  purgedAt DateTime?

  costXaf Decimal @default(0)
  version Int @version

  parts MessagePart[] @relation(fields: [id], references: [messageId])
  receipts DeliveryReceipt[] @relation(fields: [id], references: [messageId])

  // list/detail: found live running #29's own claim_live_postgres.rs
  // suite for the first time (#33) — it had never been run against a real
  // database before. Neither clause admitted a system context (kind="app",
  // appId=""), so dispatch's own candidates() query — the one `find_many`
  // the entire claim loop depends on — silently returned zero rows on
  // every call. Same root cause as App/AppClient/SenderIdRegistration/
  // OperatorPrefixRule/Provider's own read policies, just on the model
  // the claim loop actually claims, which is why it was never caught by
  // any test that only checked those models: nothing exercised dispatch's
  // own query end to end against Postgres until now.
  @@audit
  @@paged
  @@retain(days: 90)
  @@allow("list", auth().kind == "user" || appId == auth().appId || hasRole('system'))
  @@allow("detail", auth().kind == "user" || appId == auth().appId || hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
  @@emit(created, updated)
}

model MessagePart {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  messageId Cuid
  message Message @relation(fields: [messageId], references: [id])
  partIndex Int @range(min: 0, max: 9)
  udhRef Int?
  providerPartRef String?
  state MessageState @default('queued')
  submittedAt DateTime?
  deliveredAt DateTime?

  @@paged
  @@allow("list", auth().kind == "user")
  @@allow("detail", auth().kind == "user")
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
}

model DeliveryReceipt {
  id Cuid @id @default(dbgenerated())
  messageId Cuid
  message Message @relation(fields: [messageId], references: [id])
  providerId Cuid
  providerMessageRef String
  outcome DeliveryOutcome
  rawStatus String
  errorCode String?
  networkCode OperatorCode
  receivedAt DateTime @default(dbgenerated())
  occurredAt DateTime?
  rawPayload String

  @@audit
  @@paged
  @@retain(days: 90)
  // list/detail: found live via the chaos suite's own scripted
  // `a_duplicate_delivered_dlr_is_idempotent` test — the seventh instance
  // of the exact same policy-gap shape (App, AppClient,
  // SenderIdRegistration, OperatorPrefixRule, Provider, Job before it):
  // neither clause admitted a system context (kind="app", role="system"),
  // so a system-context read of DeliveryReceipt — the shape any future
  // reconciliation job, or a test proving `dlr::ingest` actually wrote a
  // receipt, needs — silently returned zero rows instead of the rows that
  // really exist.
  @@allow("list", auth().kind == "user" || hasRole('system'))
  @@allow("detail", auth().kind == "user" || hasRole('system'))
  @@allow("create", hasRole('system'))
  // #67: `purge_retention` deletes a receipt past its own 90-day
  // `@@retain` window (crates/sms-worker/src/jobs/purge_retention.rs) — the
  // tenth instance of this file's own repeated policy-gap shape, just on
  // `delete` instead of `list`/`detail`: the action was simply never
  // declared (deny-by-default, not an error) because nothing needed it
  // before this job existed. Policy-only, no DDL — `cratestack migrate
  // diff` confirmed byte-identical before/after, same as every prior
  // instance.
  @@allow("delete", hasRole('system'))
}

model Job {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  kind String @length(min: 2, max: 64)
  dedupeKey String?
  payload String
  state JobState @default('pending')
  priority Int @range(min: 0, max: 1000)
  runAt DateTime
  leaseOwner String?
  leaseUntil DateTime?
  attempts Int @default(0)
  maxAttempts Int
  lastError String?
  startedAt DateTime?
  finishedAt DateTime?
  version Int @version

  // #56: `auth().kind == "app"` added alongside the human roles, the same
  // unscoped-but-Layer-2-gated shape `SenderId`/`OptOut` already use (both
  // read by `auth().kind == "user" || auth().kind == "app"` with no owning
  // relation to scope by) — `Job` has no `appId` either, so there is no
  // per-row predicate to add beyond "any app-kind caller may pass Layer 1".
  // That makes Layer 2 (`require_permission(ctx, "job:read")`, wired via
  // `rbac::enforce_route_permission` onto `GET /jobs`/`GET /jobs/{id}` —
  // see `router.rs`) the *real* perimeter here, not defense-in-depth: unlike
  // `PROVIDER_WRITE_ROUTES`, an app-kind token genuinely can pass this
  // Layer 1 check today, so only a granted `job:read` scope (see
  // `AppClient.scopes`, §5.2) stands between any provisioned app client and
  // the whole system's job backlog. Documented in the #56/#57 PR's own
  // Reviewer Focus, not silently relied on.
  @@paged
  @@retain(days: 14)
  @@allow("list", auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))
  @@allow("detail", auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('system'))
  @@allow("update", hasRole('system'))
}

model OptOut {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  msisdnHash String @unique
  msisdn String @pii
  source OptOutSource
  scope String
  reason String?
  optedOutAt DateTime

  @@audit
  @@paged
  @@allow("read", auth().kind == "user" || auth().kind == "app")
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, deleted)
}

// #72: a standing grant of consent, evidence-shaped — who, when, through
// what channel, to what scope — not an enforcement primitive. `OptOut` is
// the enforcement primitive (its presence blocks a send outright); this
// model only proves an affirmative opt-in was captured. The two are
// deliberately not merged: an opt-out is an event with no scope-of-consent
// question ("stop everything"), a consent grant is a standing fact with
// provenance that has to survive being read back later. Withdrawing
// consent is not a field on this row (no `revokedAt`) — it is a new
// `OptOut` row, the same single enforcement mechanism `sendMessage`
// already checks, so "does this recipient currently receive X" never has
// two disagreeing sources of truth to reconcile. This model is append-only
// evidence of what was granted and when; whether it still holds is
// answered by `OptOut`'s absence, not by this model's own state.
//
// `appId`-scoped, unlike `OptOut`: an opt-out is a recipient's own
// standing decision and has to bind everywhere in this deployment: a
// consent grant is a specific app's own customer relationship (its own
// web form, its own marketing program), and there is no reason a grant
// captured for App A's marketing should authorise App B's.
//
// `scope MessageClass` reuses the existing enum rather than a second
// free-form `String` (the shape `OptOut.scope` uses) — `sendMessage`'s own
// consent check matches this column against `Message.class` directly, so
// a typo'd scope string could never silently stop matching the class it
// was meant to describe.
//
// No `@@retain` here on purpose, and this is a real, unresolved tension,
// not an oversight: `Message` purges `msisdn` at 90 days precisely
// because minimisation applies to content with no remaining purpose, but
// proof of consent is not that — it is the thing you produce *because*
// you were challenged, which argues for keeping it at least as long as
// the relationship (and probably a limitation-period buffer) lasts, not
// 90 days. Keeping `msisdn` in plaintext indefinitely to serve that need
// reproduces the exact problem #67 closed for `Message`. Not resolved
// here — see AGENTS.md's "Open questions" for the retention-period
// question, and note that `msisdnHash` (not `msisdn`) is what
// `sendMessage`'s consent check actually matches on, so a future purge
// job for this model could null `msisdn` the same way `purge_retention`
// does for `Message`, once someone decides after how long.
//
// `msisdnHash` inherits #67/§3.1's own pepper-rotation caveat unchanged:
// rotating `SMS_HASH_PEPPER` orphans every row written under the old one,
// silently, for the same reason it orphans `Message.msisdnHash` and
// `OptOut.msisdnHash` — see `sms_api::pepper`'s module doc.
model ConsentRecord {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  appId Cuid
  app App @relation(fields: [appId], references: [id])

  msisdnHash String
  msisdn String @pii

  scope MessageClass
  channel ConsentChannel
  consentedAt DateTime
  evidenceRef String?

  // Mirrors OptOut's own read/create/delete shape exactly (see that
  // model's comment for the appId difference). No `auth().kind == "app"`
  // on `create`: like OptOut, no app-level self-service consent-capture
  // API exists yet (an app's own signup backend recording consent the
  // instant a user opts in is the obvious future caller) — same status
  // quo gap OptOut already has for inbound STOP, not a new one this PR
  // introduces.
  @@audit
  @@paged
  @@allow("read", auth().kind == "user" || appId == auth().appId || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, deleted)
}

model WebhookEndpoint {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  appId Cuid
  app App @relation(fields: [appId], references: [id])
  url String @uri
  eventTypes String
  secret String
  prevSecret String?
  secretRotatedAt DateTime?
  maskRecipient Boolean
  active Boolean @default(true)
  maxAttempts Int
  circuitOpenUntil DateTime?
  consecutiveFailures Int @default(0)
  // #59: named explicitly in the ticket as evidence the absence was felt —
  // rotateWebhookSecret leaned on @isolation("serializable") alone, and
  // hooks.rs's consecutiveFailures/circuitOpenUntil/active writes were a
  // documented best-effort read-modify-write, both because this field
  // didn't exist. Both call sites now use .if_match(); their existing
  // "log and drop on any error" handling absorbs a lost race exactly like
  // it already absorbed any other write failure, so this is strictly a
  // detected-and-rejected race replacing a silent one, not a behaviour
  // change. See crates/sms-worker/src/hooks.rs and
  // crates/sms-api/src/procedures.rs::rotate_webhook_secret.
  version Int @version

  attempts WebhookAttempt[] @relation(fields: [id], references: [endpointId])

  // The eighth instance of the policy-gap shape AGENTS.md's "Invariants
  // that fail the build rather than production" section already records
  // seven times over (App, AppClient, SenderIdRegistration,
  // OperatorPrefixRule, Provider, Job, DeliveryReceipt): a model whose
  // `@@allow` omits `hasRole('system')` doesn't error — it silently
  // filters an internal system-context read down to an empty array.
  //
  // Found twice, independently and on the same day, from two directions,
  // which is itself the argument for the structural guard that section
  // asks for:
  //   - #41: `rotateWebhookSecret` reads *and updates* this model under a
  //     system context (`Procedures::sys`), not the caller's own ctx —
  //     hence the clause on `update` below as well as `read`.
  //   - #38/#39: the Message.created/updated subscribers
  //     (`crates/sms-api/src/webhooks.rs`) resolve which endpoints
  //     subscribe to an event type by reading this model under a system
  //     context. Without the clause the subscriber matches zero endpoints
  //     against every event, forever, with nothing anywhere to notice.
  //
  // Guarded by `crates/sms-api/tests/system_context_golden_list_live_postgres.rs`.
  //
  // #187: `read` used to be `auth().kind == "user" || hasRole('system')` —
  // any authenticated human role, including `auditor`/`operator`/`support`,
  // none of which hold any webhook permission (§5.2), could read a live
  // signing secret (`secret`/`prevSecret`) that only owner/admin/developer
  // could ever write. `@sensitive` does not help here — AGENTS.md and
  // docs/architecture.md both record that it redacts audit snapshots only
  // and adds no serde attribute, so the field is still returned by the API.
  // Narrowed to match who can already write, on the reasoning that an
  // auditor's oversight need is served by seeing *that* a secret exists,
  // was rotated, and when (all still visible — only `secret`/`prevSecret`
  // are), not by seeing its value: a signing secret is a credential, not a
  // record. This is a reversible product call, not a forced one — the
  // named alternative was leaving `read` at "any human" and instead
  // deciding secrets don't belong on a model humans read at all (the
  // issue's own second option). Latent either way as of this writing:
  // `GatewayAuth` never mints a human-role token today (#97/#98's scope
  // cut), so nothing can currently reach this clause from either side.
  @@audit
  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('developer') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin') || hasRole('developer'))
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('developer') || hasRole('system'))
  @@allow("delete", hasRole('owner') || hasRole('admin'))
  @@emit(created, updated, deleted)
}

model WebhookAttempt {
  id Cuid @id @default(dbgenerated())
  endpointId Cuid
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
  sourceEventId Uuid
  aggregateId Cuid
  eventType String
  payload String
  state AttemptState @default('pending')
  attempts Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  nextAttemptAt DateTime?
  lastStatusCode Int?
  lastError String?
  lastAttemptAt DateTime?
  deliveredAt DateTime?
  version Int @version

  // The ninth instance of the policy-gap shape AGENTS.md's "Invariants that
  // fail the build rather than production" section already records eight
  // times over (App, AppClient, SenderIdRegistration, OperatorPrefixRule,
  // Provider, Job, DeliveryReceipt, WebhookEndpoint): a model whose
  // `@@allow` omits `hasRole('system')` doesn't error — it silently filters
  // an internal system-context read down to an empty array.
  //
  // Unlike the first eight, this one never shipped broken either — #38/#39's
  // own PR flagged it explicitly, in advance, in this exact comment's
  // predecessor: "WebhookAttempt's own list/detail policy has no
  // hasRole('system') branch at all — only create/update do... #40's hooks
  // claim loop will need that clause the moment it exists to claim attempts
  // for delivery." #40 (this change) is that moment: `claim::Claimable for
  // WebhookAttempt`'s own `candidates()` (crates/sms-worker/src/claim.rs)
  // reads this model under `sys()` to find due attempts.
  //
  // Guarded by `crates/sms-api/tests/system_context_golden_list_live_postgres.rs`.
  @@paged
  @@retain(days: 30)
  @@allow("list", auth().kind == "user" || endpoint.appId == auth().appId || hasRole('system'))
  @@allow("detail", auth().kind == "user" || endpoint.appId == auth().appId || hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
}

model User {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  subject String @unique
  email String @unique @email
  displayName String @length(min: 1, max: 128)
  roleKey String
  role Role @relation(fields: [roleKey], references: [key])
  active Boolean @default(true)
  lastLoginAt DateTime?
  mfaEnrolled Boolean @default(false)
  deletedAt DateTime?
  // #59: a role reassignment racing another admin's edit of the same user
  // is a textbook lost-update — the canonical case this ticket exists for.
  version Int @version

  @@soft_delete
  @@audit
  @@paged
  // read: the tenth instance of this file's own nine-times-repeated
  // hasRole('system') gap (see AGENTS.md's "Invariants" section) — closed
  // here rather than found live, because #194's own login flow has to look
  // up a User by subject *before* any human principal exists, which
  // necessarily runs under a system context. Without this clause that
  // lookup would silently match zero rows (CrateStack's list-route policy
  // denial is row-level filtering, not a 403) and every login would fail
  // as though the account didn't exist.
  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('auditor') || hasRole('system'))
  @@allow("create", hasRole('owner') || hasRole('admin'))
  // update: hasRole('system') added alongside — a successful login stamps
  // lastLoginAt (crates/sms-auth/src/login.rs), and that write runs under
  // the same system context the read above does, for the same reason: it
  // happens before any human principal exists to hold owner/admin.
  @@allow("update", hasRole('owner') || hasRole('admin') || hasRole('system'))
  @@allow("delete", hasRole('owner'))
  @@emit(created, updated, deleted)
}

model Role {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  key String @unique @regex("^[a-z][a-z0-9_]{2,31}$")
  label String @length(min: 2, max: 64)
  description String?
  builtin Boolean @default(false)
  permissions String
  // #59: two admins editing the same role's permission set concurrently.
  version Int @version

  @@audit
  // read: same reasoning as User's own read policy just above — the login
  // flow's Role -> permissions lookup runs under a system context too, and
  // `auth().kind == "user"` alone never admits one (system's kind is
  // "app", per Principal::into_context's system_context() convention).
  @@allow("read", auth().kind == "user" || hasRole('system'))
  @@allow("create", hasRole('owner'))
  @@allow("update", hasRole('owner'))
  @@allow("delete", hasRole('owner'))
  @@emit(created, updated, deleted)
}

// A human User's password credential, deliberately NOT a field on User
// itself (#194). Two reasons, both hard constraints rather than style:
//
// 1. §2.0's own grammar table: "No field-level read masking. Model-level
//    access only." @sensitive redacts audit snapshots ONLY — a @sensitive
//    field is still returned verbatim by GET /users/{id} to every role
//    User.read already admits (owner/admin/auditor). A password hash is
//    exactly the field that must never appear in an HTTP response body,
//    and the only mechanism this framework offers for that is model-level
//    @@allow — hence a separate model, restricted to hasRole('system')
//    on every action, the same isolation OauthSigningKey.privateKeyPem
//    already uses for the OP's own signing key.
// 2. Keeping User itself unchanged means the nine-times-documented
//    hasRole('system') fix above is the only change to a model this PR
//    doesn't own the shape of — every other field on User predates #194.
//
// This is a deliberate, flagged deviation from the issue's own "needs no
// new models" framing — see the PR body's Risk Assessment for why local
// password storage was chosen over a federated external-IdP flow, and why
// that choice makes this model unavoidable rather than optional.
model UserCredential {
  @use(Timestamps)

  id Cuid @id @default(dbgenerated())
  userId Cuid @unique
  user User @relation(fields: [userId], references: [id])
  // Argon2id PHC string (crates/sms-auth/src/login.rs) — never a raw
  // digest, never reversible, never logged. @sensitive is redundant with
  // the model-level isolation above but costs nothing and matches
  // OauthSigningKey.privateKeyPem's own belt-and-braces convention.
  passwordHash String @sensitive

  // Every action hasRole('system') only — never auth().kind == "user",
  // never any human role, not even 'owner'. No console screen, present or
  // future, may read or write this model directly; the login procedure is
  // its one caller. Mirrors OauthSigningKey's own @@allow shape exactly,
  // for the same reason (see that model's own schema comment).
  @@allow("read", hasRole('system'))
  @@allow("create", hasRole('system'))
  @@allow("update", hasRole('system'))
  @@allow("delete", hasRole('system'))
}

// #68: periodic hash anchoring over `cratestack_audit` — see
// crates/sms-worker/src/jobs/anchor_audit.rs's own module doc for the full
// design (hash-chain vs Merkle-snapshot vs external anchoring, and exactly
// what this proves and does not). One row per `anchor_audit` run: the
// SHA-256 fold of every `cratestack_audit` row in (periodStart, periodEnd],
// chained to the previous anchor's own chainHash so editing or deleting any
// covered audit row — or any earlier anchor row itself — breaks every link
// after it.
//
// Write-once by construction, not by convention: no @@allow("update", ...)
// and no @@allow("delete", ...) clause exists at all, and this schema's own
// deny-by-default (§2.0) makes both actions unreachable through any role,
// including `system` — nothing in this codebase, ever, updates or deletes
// an anchor row. No @@audit on this model itself: the table already IS an
// immutable, append-only record, and an audit trail of an audit trail is
// circular, not useful. No @@retain: unlike Message/DeliveryReceipt, an
// anchor is the compliance artifact, not the thing being minimised — it
// must outlive every retention window it stands witness to.
model AuditAnchor {
  id Cuid @id @default(dbgenerated())
  // Exclusive lower bound. Null only on the very first anchor this
  // deployment ever writes, meaning "everything up to periodEnd" — there is
  // no earlier anchor to inherit a boundary from.
  periodStart DateTime?
  // Inclusive upper bound — see the module doc for why this is `now` minus
  // a small safety lag, not `now` itself.
  periodEnd DateTime
  rowCount Int
  // Hex SHA-256, sequential fold over every covered row in
  // (occurred_at, event_id) order. Recomputable from `cratestack_audit`
  // alone; stored for diagnostics without requiring a recompute to see
  // which period a mismatch falls in.
  rangeHash String @length(min: 64, max: 64) @db_enforce
  // The previous anchor's chainHash, verbatim, or 64 '0' characters (the
  // hex encoding of the fixed 32-byte genesis value — see the module doc's
  // GENESIS constant) on the very first anchor, which has no predecessor.
  // A sentinel, not `String?`: `@length` on a nullable field was tried
  // first and found to break the *generated* `UpdateAuditAnchorInput`'s
  // `validate()` — cratestack-macros' `validate_impl_tokens(&fields, true)`
  // (unconditionally generated for every model regardless of whether
  // `@@allow("update", ...)` exists to route to it) wraps every update
  // field in one `Option<...>` for "present or absent" regardless of the
  // field's own nullability, so a `String?` field becomes
  // `Option<Option<String>>` there; `emit_field_validators`'s own
  // optionality check only unwraps one layer, so `validate_length` is
  // called with `&Option<String>` where it needs `&str` — `cargo check -p
  // sms-api` fails with `E0308` naming exactly that mismatch. Filed
  // upstream; a non-nullable sentinel sidesteps it entirely rather than
  // waiting on a fix, and reads as a cleaner design in its own right — this
  // field is never actually absent in the cryptographic sense, "no
  // predecessor" is itself a fixed, known value. A plain `String`, not a
  // self-relation: the link that matters here is cryptographic (does this
  // value equal what the previous row actually stored), not referential.
  prevChainHash String @length(min: 64, max: 64) @db_enforce
  // Hex SHA-256 over prevChainHash + periodStart + periodEnd + rowCount +
  // rangeHash — i.e. it commits to this row's own metadata, not just to
  // rangeHash, so tampering with periodStart/periodEnd/rowCount on an
  // existing anchor row is exactly as detectable as tampering with the
  // audit rows it covers.
  chainHash String @unique @length(min: 64, max: 64) @db_enforce
  createdAt DateTime @default(dbgenerated())

  @@allow("read", hasRole('owner') || hasRole('admin') || hasRole('auditor') || hasRole('system'))
  @@allow("create", hasRole('system'))
}

type SendMessageInput {
  to String
  body String
  senderId String?
  class MessageClass?
  clientRef String?
  scheduledAt DateTime?
  validityMinutes Int?
}

type SendMessageResult {
  messageId Cuid
  state MessageState
  encoding Encoding
  segments Int
  operator OperatorCode
  estimatedCostXaf Decimal
}

type PreviewInput {
  body String
  to String?
}

type PreviewResult {
  encoding Encoding
  segments Int
  length Int
  perSegment Int
  offending String[]
  suggestion String?
  operator OperatorCode
  normalizedTo String?
}

type ProvisionClientInput {
  appId Cuid
  label String
  scopes String[]
}

// No clientSecret: #6 settled the auth shape as private_key_jwt-only, so
// there is no shared secret anywhere in this system (see OauthClient's own
// comment). provisionAppClient generates the client's RSA keypair
// server-side, persists only the derived public JWK onto OauthClient.jwks,
// and hands back the private key here exactly once — this is the
// asymmetric analogue of "secret shown once." Nothing after this response
// can ever recover it; a client that loses it needs a fresh provisioning
// call (#23's PR description covers retirement/rotation scope).
type ProvisionClientResult {
  clientId String
  privateKeyPem String
}

type CancelInput {
  messageId Cuid
  reason String?
}

type EndpointInput {
  endpointId Cuid
}

type ReplayWebhookAttemptInput {
  attemptId Cuid
}

type EnqueueJobInput {
  kind String
  payload String
  dedupeKey String?
  runAt DateTime?
}

mutation procedure sendMessage(args: SendMessageInput): SendMessageResult
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @isolation("read_committed")

procedure previewMessage(args: PreviewInput): PreviewResult
  @allow(auth() != null)

procedure listMessagesPage(appId: Cuid?, state: MessageState?, limit: Int?, offset: Int?): Page<Message>
  @allow(auth() != null)

mutation procedure cancelMessage(args: CancelInput): Message
  @allow(hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @authorize(Message, detail, args.messageId)
  @isolation("serializable")

mutation procedure enqueueJob(args: EnqueueJobInput): Job
  @allow(hasRole('owner') || hasRole('admin'))
  @isolation("read_committed")

mutation procedure provisionAppClient(args: ProvisionClientInput): ProvisionClientResult
  @allow(hasRole('owner') || hasRole('admin'))
  @isolation("serializable")

mutation procedure rotateWebhookSecret(args: EndpointInput): WebhookEndpoint
  @allow(hasRole('owner') || hasRole('admin') || hasRole('developer'))
  @isolation("serializable")

// #43: re-fire a stuck WebhookAttempt from the admin surface. Same @allow
// set as rotateWebhookSecret — the same three human roles the endpoint
// itself is managed by — plus a Layer 2 `webhook:manage` check
// (`require_permission`, §5.1) inside the procedure body, which
// rotateWebhookSecret does not have; see procedures.rs's own doc for why
// this one gets it and that one, so far, doesn't. `@authorize` requires the
// caller to already be able to see the row (WebhookAttempt's own `detail`
// policy) before the mutation runs, the same guard `cancelMessage` uses.
mutation procedure replayWebhookAttempt(args: ReplayWebhookAttemptInput): WebhookAttempt
  @allow(hasRole('owner') || hasRole('admin') || hasRole('developer'))
  @authorize(WebhookAttempt, detail, args.attemptId)
  @isolation("serializable")

// #56: re-enqueue a `dead` Job from the admin surface — the same "reset the
// existing row rather than creating a new one" shape `replayWebhookAttempt`
// (#43) already established for `WebhookAttempt`, adapted to `Job`'s own
// state machine. Only `dead -> pending` is new (§2.10's table, `0002_bootstrap`
// regenerated); `failed -> pending` already exists (`jobs.rs`'s own automatic
// backoff-retry uses it) but `failed` is a transient, same-tick state no
// operator can realistically observe and click a button against — by the
// time a poll renders it, `apply_failure` has already moved it on to
// `pending` or `dead` — so this procedure is scoped to `dead` alone; see
// `procedures.rs`'s own doc on `requeue_job` for the full reasoning and the
// `409 Conflict` this returns for anything else.
type RequeueJobInput {
  jobId Cuid
}

mutation procedure requeueJob(args: RequeueJobInput): Job
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator'))
  @authorize(Job, detail, args.jobId)
  @isolation("serializable")

// #57: which node holds which singleton-role advisory lock — `pg_locks`
// joined against `pg_stat_activity`, read via `crates/sms-api/src/
// worker_locks.rs` (a new, named R1 exception: `pg_locks` is Postgres's own
// lock catalog, not one of this schema's models, so no delegate can read
// it — see CONTRIBUTING.md's exceptions table). No model backs this type
// either, so nothing here touches DDL.
type WorkerLockInfo {
  role String
  singleton Boolean
  held Boolean
  workerId String?
  pid Int?
  heldSince DateTime?
}

type WorkerLocksResult {
  locks WorkerLockInfo[]
}

procedure workerLocks(): WorkerLocksResult
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('system'))

// #54: the route simulator — "given this recipient, class and app, which
// route wins and why" without sending anything (the epic's own words).
// Every type below is a rendering of `sms_routing::Decision`
// (crates/sms-routing, #62's pure engine) for the wire — never a
// re-decision. `crates/sms-api/src/route_simulator.rs`'s own module doc
// covers the mapping and the test that proves it can't silently drift from
// the engine. No model backs any of this, so nothing here touches DDL.

enum RouteOutcomeKind {
  excluded
  disabled
  predicate_failed
  provider_unavailable
  eligible
}

// Mirrors `sms_routing::PredicateFailure`'s four variants — which
// `match*` predicate a route failed on. `app_id`, not `appId`: enum
// variants are lowercase-verbatim, and every existing multi-word variant
// in this schema (`ProviderKind.orange_cm_http`,
// `OperatorPrefixSource.manual`) uses snake_case, never camelCase.
enum PredicateKind {
  operator
  class
  app_id
  prefix
}

// One `sms_routing::RouteEvaluation` per input route, in input order —
// `sms_routing::Decision.evaluations` covers every route unconditionally
// (excluded/disabled/ineligible included), so a caller never has to
// re-derive "why wasn't route X picked" from anything but this list. The
// `predicate*`/`unavailableReason` fields are pre-rendered display strings
// (e.g. "mtn", "677"), not a second copy of `sms_routing`'s own typed
// `PredicateFailure` — a lossless, purely presentational flattening of a
// Rust enum onto nullable wire fields, the same shape `WorkerLockInfo`
// above already uses for a different Rust struct.
type RouteEvaluationInfo {
  routeId Cuid
  routeName String
  priority Int
  weight Int
  providerId Cuid
  outcome RouteOutcomeKind
  // Only meaningful when `outcome == eligible` — `true` for the route(s)
  // that actually entered the weighted draw (the highest-priority band
  // with at least one eligible member). See `sms_routing::RouteOutcome::
  // Eligible`'s own doc.
  winningBand Boolean
  predicateKind PredicateKind?
  predicateExpected String?
  predicateActual String?
  unavailableReason String?
}

// One member of the winning priority band, as it entered the weighted
// draw — mirrors `sms_routing::TieBreakRange`.
type TieBreakRangeInfo {
  routeId Cuid
  weight Int
  low Float
  high Float
}

// Present iff the winning priority band had more than one eligible member
// — mirrors `sms_routing::TieBreak`.
type TieBreakInfo {
  priority Int
  draw Float
  ranges TieBreakRangeInfo[]
  winnerRouteId Cuid
}

// Mirrors `sms_routing::Winner`.
type RouteWinnerInfo {
  routeId Cuid
  providerId Cuid
  failoverRouteId Cuid?
}

// `draw` is optional and defaults to a fresh `rand::random()` per call —
// the same "production draws once, a replay supplies the exact same
// value" property `sms_routing::select_route`'s own doc describes,
// exposed here so a caller can either take a realistic, freshly-drawn
// sample (the common case: "what would happen right now") or pin an exact
// value to see how a specific draw resolves a tie, without needing this
// procedure to know anything about why.
type SimulateRouteInput {
  msisdn String
  class MessageClass
  appId Cuid
  draw Float?
}

type SimulateRouteResult {
  // Classified the same way `sendMessage` classifies it (`Procedures::
  // classify_operator`, `OperatorPrefixRule`) — a routing *hint*, never
  // load-bearing, per `sms-msisdn::operator`'s own doc.
  operator OperatorCode
  msisdnNational String
  // `true` only when zero `Route` rows exist in the system at all — the
  // #62-documented "dispatch refuses, loudly" state. Distinguished from
  // "routes exist, none matched" (`evaluations` non-empty, `winner` null)
  // so the simulator can render a dedicated banner rather than a table
  // that merely looks empty. See `crates/sms-worker/src/routing.rs`'s own
  // `explain_no_route` for the `stateReason` an operator sees on a
  // rejected message when this happens for real.
  noRoutesConfigured Boolean
  evaluations RouteEvaluationInfo[]
  tieBreak TieBreakInfo?
  winner RouteWinnerInfo?
}

procedure simulateRoute(args: SimulateRouteInput): SimulateRouteResult
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))
type MessageReceiptsInput {
  messageId Cuid
}

// #50: the message detail timeline's own receipt evidence — deliberately
// narrower than the DeliveryReceipt model itself. No rawPayload (the
// provider's raw wire body) reaches the console; every other field is the
// evidence a human needs to see "what did the provider actually say, and
// when." See `procedures.rs::list_message_receipts`'s own doc for why this
// is a bespoke type rather than the model: DeliveryReceipt's own
// list/detail policy (`auth().kind == "user" || hasRole('system')`) never
// admits this deployment's only real caller kind, `"app"`.
type DeliveryReceiptSummary {
  id Cuid
  providerId Cuid
  outcome DeliveryOutcome
  rawStatus String
  errorCode String?
  networkCode OperatorCode
  receivedAt DateTime
  occurredAt DateTime?
}

type MessageReceiptsResult {
  receipts DeliveryReceiptSummary[]
}

// #50: the timeline's own data source, chosen over the other two options
// #50 itself names (the audit log — accurate, but needs a policy and a
// route that don't exist; explicit transition rows — the most honest, but
// a real schema change) precisely because DeliveryReceipt rows already
// exist and are already the closest thing this schema has to a transition
// history. `@authorize` enforces the same ownership boundary
// `cancelMessage`/`requeueJob` already rely on: a caller can only ever
// request receipts for a Message their own row policy already lets them
// read, so cross-app access fails exactly the way `getMessageById` already
// does (a 404, not a 403 — `@vsms/gateway/messages.ts`'s own doc, point 9).
procedure listMessageReceipts(args: MessageReceiptsInput): MessageReceiptsResult
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))
  @authorize(Message, detail, args.messageId)

// #49: the operator dashboard — throughput, delivery rate by operator,
// queue/job/outbox depth, and a UCS-2-ratio trend. The epic's own worked
// example is the acceptance bar: "a sudden jump means someone shipped a
// template with a ç or a smart apostrophe, and it will show up in the
// bill before anyone notices in the UI" — a bare percentage can't show a
// jump, so this returns a short trend, not just a current value. No model
// backs any of this (same as WorkerLocksResult/SimulateRouteResult
// above), so nothing here touches DDL. See `crates/sms-api/src/
// procedures.rs`'s own doc on `dashboard_snapshot` for exactly which
// model each field reads, under which context (app-scoped vs
// system-wide), and why: cratestack's own `aggregate()` has no GROUP
// BY — `db.<model>().aggregate().count()`/`.sum()`/`.avg()`/`.min()`/
// `.max()` only (`cratestack-sqlx-0.7.10/src/query/read/aggregate.rs`'s
// own doc comment) — so every bucket here is its own explicit,
// policy-scoped delegate call rather than one grouped query.

// One rolling hour of `Message.createdAt`, oldest first. `totalCount` is
// that hour's throughput; `ucs2Count` is how many of those encoded UCS-2.
// Both come from the same underlying scan (see procedures.rs), so the
// throughput and UCS-2 tiles share one source of truth rather than
// disagreeing after two independent computations.
type HourlyBucket {
  bucketStart DateTime
  totalCount Int
  ucs2Count Int
}

// Delivery rate by operator, over a trailing 24h window. `terminalTotal`
// deliberately excludes `uncertain`/`undelivered` — see DashboardSummary's
// own comment on `stuckMessages` for why folding either into this ratio
// would misstate it in one direction or the other.
type OperatorDeliveryStats {
  operator OperatorCode
  delivered Int
  terminalTotal Int
}

type DashboardSummary {
  generatedAt DateTime
  // Empty when the caller isn't scoped to a single app (a real human or
  // system context, per Message's own `@@allow`) — see the console's own
  // scope banner precedent (`messages-screen.tsx`) for why this is stated
  // on screen rather than left for an operator to infer.
  appId Cuid?

  // Current count of Message rows in {accepted, queued, routed} — not
  // time-windowed; a live gauge, not a rate.
  queueDepth Int

  // Current count of Job rows in {pending, running}, system-wide — Job
  // has no appId to scope a row-level predicate by (the same shape the
  // Jobs screen's own banner already states, #56/#57).
  jobBacklog Int

  // Current count of WebhookAttempt rows in {pending, delivering}, scoped
  // to this app's own WebhookEndpoints (`WebhookAttempt`'s `@@allow` has
  // no unscoped `auth().kind == "app"` clause — only `endpoint.appId ==
  // auth().appId`). A genuine *depth* count — distinct from, and does not
  // recompute, `sms_webhook_outbox_oldest_undelivered_age_seconds` /
  // `sms_event_outbox_poison_rows` (Prometheus, `crates/sms-metrics`):
  // those describe the framework's own internal `cratestack_event_outbox`
  // table (drained by the `drain` role), not this schema's `WebhookAttempt`
  // rows (delivered by the `hooks` role) — two different tables, two
  // different numbers. See procedures.rs for the full reasoning.
  outboxDepth Int

  // Current count of Message rows in {uncertain, undelivered} — messages
  // never confirmed either delivered or failed. Reported on its own,
  // never folded into `operatorStats`: counting one as a failure
  // overstates failure, counting it as delivered is a lie.
  stuckMessages Int

  // Trailing 24h, one row per OperatorCode variant, including zero-count
  // ones — the caller decides whether to render an empty row.
  operatorStats OperatorDeliveryStats[]

  // Six rolling hours, oldest first — the throughput and UCS-2-ratio
  // trend. `hourlyBuckets[5]` is the current, in-progress hour.
  hourlyBuckets HourlyBucket[]
}

procedure dashboardSummary(): DashboardSummary
  @allow(auth().kind == "app" || hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('auditor') || hasRole('system'))

// #52: provision a console account from the admin screens — the same
// "generate server-side, return once" shape `provisionAppClient` (#23)
// already established for a client's private key, applied here to a
// human's one-time password. `User.create`'s own `@@allow` already admits
// `hasRole('owner') || hasRole('admin')` directly (a plain `POST /users`
// would work) but `UserCredential` is `hasRole('system')`-only on every
// action (see that model's own schema comment — no console screen may
// read or write it directly), so nothing outside a procedure running under
// a system context can ever attach a password to the account it just
// created. See `crates/sms-api/src/procedures.rs::provision_user`'s own
// doc for why the hashing itself lives in `sms_core::password` rather than
// `sms-auth::login` (where it lived before this procedure needed it too).
//
// No retire/deactivate action here: `User.active`/`PATCH /users/{id}`
// (owner/admin, already reachable) is the existing, coarser mechanism —
// the same "documented coarser fallback, not silently pretended to be
// more" precedent `AppClient.active`/`retiredAt` set for #23. There is
// also no password-rotation or reset procedure anywhere in this schema —
// see OPEN_QUESTIONS.md for why that is a named, accepted gap rather than
// an oversight.
type ProvisionUserInput {
  email String
  displayName String
  roleKey String
}

type ProvisionUserResult {
  userId Cuid
  email String
  roleKey String
  // Shown exactly once — this procedure's response is the only place it
  // ever exists outside the Argon2id hash `UserCredential.passwordHash`
  // stores. Never logged, never persisted a second time.
  password String
}

mutation procedure provisionUser(args: ProvisionUserInput): ProvisionUserResult
  @allow(hasRole('owner') || hasRole('admin'))
  @isolation("serializable")

// #58: record an opt-out from a plaintext MSISDN. `OptOut.create`'s own
// `@@allow` already admits `hasRole('owner') || hasRole('admin') ||
// hasRole('operator')` directly, but every one of those callers would need
// to compute `msisdnHash` themselves first — and the console has no access
// to `SMS_HASH_PEPPER` (by design; see `sms_api::pepper`'s own module doc),
// so it structurally cannot. This procedure does the one thing a plain
// `POST /opt_outs` cannot: hash server-side, under the pepper only
// `sms-api` ever holds, the same way `sendMessage`'s own opt-out check
// already does internally.
//
// `hasRole('support')` is added here even though `OptOut.create`'s own
// `@@allow` doesn't admit it — §5.2's role table grants `support` the
// `optout:manage` permission specifically because opt-outs are that role's
// stated job ("first-line support"), but Layer 1 on the model itself had
// no clause admitting it at all, which would have made the grant dead on
// arrival the moment a `support` account existed to use it (#194's own
// human-login path). This procedure runs its write under this crate's
// internal `sys()` context regardless of the caller's own role — the same
// pattern `provisionAppClient`/`rotateWebhookSecret` already use — so it
// needed no change to `OptOut.create`'s own `@@allow` to grant `support`
// real write access; only this procedure's own `@allow` needed to admit
// the role that permission is meant for.
type RecordOptOutInput {
  msisdn String
  source OptOutSource
  scope String
  reason String?
}

mutation procedure recordOptOut(args: RecordOptOutInput): OptOut
  @allow(hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('support'))
  @isolation("serializable")

// #58: search opt-outs by a plaintext MSISDN the caller supplies — the
// read-side mirror of `recordOptOut` above, for the identical "the console
// cannot compute msisdnHash itself" reason. `OptOutSummary` is a bespoke
// type rather than `OptOut` itself, the same "lossless, presentational
// flattening" precedent `DeliveryReceiptSummary`/`WorkerLockInfo` already
// set, not a new convention invented here.
//
// **What "not found" can honestly mean, and why this procedure cannot
// tell the two apart:** either no opt-out was ever recorded for this
// number, or one was, under a `SMS_HASH_PEPPER` value that has since
// rotated — a rotation orphans every `msisdnHash` computed under the old
// pepper, silently, forever (OPEN_QUESTIONS.md §3.1; `sms_api::pepper`'s
// own module doc). This procedure never had the plaintext of any row
// other than the one it's about to hash and compare, so it has no way to
// distinguish "genuinely never opted out" from "opted out, but unfindable
// since the last rotation" — see `crates/sms-api/src/procedures.rs::
// search_opt_out`'s own doc for how the search is built specifically so a
// caller can never be shown someone else's row by accident even though it
// cannot make this particular distinction. The console's own copy states
// the caveat plainly rather than implying a clean "not opted out."
type OptOutSummary {
  id Cuid
  msisdnHash String
  source OptOutSource
  scope String
  reason String?
  optedOutAt DateTime
  createdAt DateTime
}

type OptOutSearchInput {
  msisdn String
}

type OptOutSearchResult {
  optOut OptOutSummary?
}

procedure searchOptOutByMsisdn(args: OptOutSearchInput): OptOutSearchResult
  @allow(hasRole('owner') || hasRole('admin') || hasRole('operator') || hasRole('support'))

// #58: the read-only console view over `cratestack_audit` and its own
// `AuditAnchor` hash chain. See `crates/sms-api/src/audit_log.rs`'s own
// module doc for the full mechanism — moved there from #68's
// `anchor_audit` job so the writer and this reader share one
// implementation rather than risking two hash algorithms silently
// drifting apart. No model backs either type below (same as
// `WorkerLocksResult`/`SimulateRouteResult` above), so nothing here
// touches DDL — and there is no write counterpart to either procedure: see
// `audit_log.rs`'s own doc for the compile-time proof that no
// `AuditAnchor` update/delete path exists at all, for any role.
type AuditLogQuery {
  model String?
  operation String?
  // Matches `actor->>'id'` in the raw `cratestack_audit` row — the one
  // sub-field every audited write's `actor` JSONB blob populates. "Who did
  // this," not a free-text search.
  actorId String?
  since DateTime?
  until DateTime?
  limit Int?
  offset Int?
}

// A lossless, presentational flattening of one `cratestack_audit` row —
// `primaryKey`/`actor`/`before`/`after` stay JSON-encoded `String`s rather
// than this schema inventing a second JSON scalar type, the same
// convention `Provider.config`/`Route.config` already use for a
// JSON-shaped column.
type AuditLogEntry {
  eventId String
  model String
  operation String
  primaryKey String
  actor String
  tenant String?
  before String?
  after String?
  requestId String?
  occurredAt DateTime
}

type AuditLogPage {
  entries AuditLogEntry[]
  hasMore Boolean
}

procedure auditLog(args: AuditLogQuery): AuditLogPage
  @allow(hasRole('owner') || hasRole('admin') || hasRole('auditor'))

// No arguments — mirrors `dashboardSummary`'s own "one system, one answer"
// shape (#49): there is exactly one audit chain in this deployment, not
// one per caller.
type AuditChainStatus {
  latestAnchorId Cuid?
  latestPeriodEnd DateTime?
  latestRowCount Int?
  // Empty means every anchor's own prevChainHash/chainHash links are
  // internally consistent — see `audit_log.rs::verify_chain_linkage`'s own
  // doc for exactly what this can and cannot catch.
  linkageBreaks String[]
  // `null` when there is no anchor yet, or the content re-verification
  // itself could not run this call (a transient read failure, not a
  // tampering finding) — see `ChainStatus::latest_period_content_verified`'s
  // own doc for why that's deliberately not folded into `false`.
  latestContentVerified Boolean?
}

procedure auditChainStatus(): AuditChainStatus
  @allow(hasRole('owner') || hasRole('admin') || hasRole('auditor'))
