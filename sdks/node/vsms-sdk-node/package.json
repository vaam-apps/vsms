{
  "name": "@vaam-apps/vsms-node",
  "version": "0.10.0",
  "description": "Official Node.js SDK for vsms: signs every request with your Ed25519 key (COSE_Sign1) and verifies every answer against the gateway's pinned keys, so there is no token to acquire or refresh.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaam-apps/vsms.git",
    "directory": "sdks/node/vsms-sdk-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm-test": "bash scripts/build-wasm.sh --responder",
    "build:ts": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc -p tsconfig.json --emitDeclarationOnly",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build:wasm-test && node scripts/run-tests.mjs",
    "test:live": "node --experimental-strip-types live/gateway.live.ts"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
