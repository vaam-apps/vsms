{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DASHBOARD_AUTH",
        "DASHBOARD_BASIC_REALM",
        "DASHBOARD_BASIC_USERS",
        "SMS_API_URL",
        "SMS_API_CLIENT_CERT_PATH",
        "SMS_API_CLIENT_KEY_PATH",
        "SMS_API_CA_PATH",
        "SMS_AUTH_ISSUER",
        "SMS_CONSOLE_CLIENT_ID",
        "SMS_CONSOLE_PRIVATE_KEY_PATH",
        "SMS_CONSOLE_SCOPE",
        "MESSAGE_STREAM_POLL_MS",
        "NEXT_PUBLIC_APP_NAME"
      ]
    },
    "lint": {
      "outputs": []
    },
    // typecheck must not run ahead of (or concurrently with) this package's
    // own build: frontends/apps/admin/tsconfig.json's `include` lists
    // `.next/types/**/*.ts`, which `next build` generates partway through
    // its own run. This dependency was added in #133, then silently lost
    // during #135's merge (its turbo.json diff shows the line removed with
    // no mention in the commit body) — #135 branched before #133 landed
    // and the rebase/merge dropped it. Confirmed live rather than assumed:
    // `.turbo/runs/*.json` from a forced `typecheck build` run shows
    // `admin#typecheck` starting at the same millisecond as `admin#build`
    // and finishing ~17s before it — silently type-checking without the
    // generated `.next/types` in scope, not erroring (tsc tolerates an
    // `include` glob matching nothing), so the failure mode is a false
    // pass, not a crash.
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // frontends/packages/sms-client (T3) is generated at build time and gitignored
    // (see .gitignore's comment there and GENERATING.md) — everything
    // except its package.json. Turbo's default task hashing only looks at
    // git-tracked (and untracked-but-not-ignored) files, so a regenerated
    // src/ that happens to be gitignored is INVISIBLE to it by default:
    // confirmed live — mutating a gitignored file under
    // frontends/packages/sms-client/src and rerunning `turbo run build` served a
    // stale `cache hit` with the old output, no rebuild at all. Declaring
    // `inputs` explicitly overrides that default and forces turbo to hash
    // these globs regardless of .gitignore, which is exactly what's
    // needed: the generator must run before this task (see justfile's
    // `client-gen`/CI's `js` job ordering), and every run after that has
    // to be seen as a real content change, not silently served from a
    // build made against a different schema.
    "@vsms/sms-client#build": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    // @vaam-apps/vsms-node (VS-7) seals through `sdks/rust/vsms-sdk-wasm`,
    // compiled to WebAssembly into this package's `wasm/` by
    // `scripts/build-wasm.sh`. Two things turbo's defaults get wrong for it:
    // `wasm/` is gitignored, so it is not an output unless named (a cache hit
    // would restore `dist/` and leave the package unable to load its sealing
    // module), and the crate lives outside the package, so a change to it, to
    // the schema it expands or to the lockfile pinning its dependencies is
    // invisible to the package's own input hash (a stale module served from
    // cache after a Rust change). Declaring `inputs` replaces the default set,
    // so the package's own files are named too.
    "@vaam-apps/vsms-node#build": {
      "outputs": ["dist/**", "wasm/**"],
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "tsconfig.json",
        ".swcrc",
        "$TURBO_ROOT$/sdks/rust/Cargo.toml",
        "$TURBO_ROOT$/sdks/rust/Cargo.lock",
        "$TURBO_ROOT$/sdks/rust/vsms-sdk-wasm/**",
        "$TURBO_ROOT$/sdks/rust/vsms-sdk-rust/schema.cstack"
      ]
    }
  },
  "globalEnv": ["NODE_ENV", "SKIP_ENV_VALIDATION", "CRATESTACK_BIN"],
  // Where `@vaam-apps/vsms-node#build` and `#test` find their Rust toolchain
  // (`scripts/build-wasm.sh` runs cargo). Turbo's strict mode drops every
  // variable not named, and with them a `RUSTUP_TOOLCHAIN` pin or a relocated
  // cargo home would silently stop reaching cargo. Pass-through, not `env`: none
  // of these changes what the build produces, so none should invalidate a cache.
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "CARGO_BUILD_JOBS",
    "CARGO_TARGET_DIR",
    "RUSTUP_HOME",
    "RUSTUP_TOOLCHAIN"
  ]
}
